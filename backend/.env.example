# ── LUPU Backend Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=production   # 'production' in prod — disables debug logs, enables strict CORS

# ── MongoDB Atlas (Production) ────────────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Replace <username>, <password>, <cluster>, and specify database 'lupu'
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lupu?retryWrites=true&w=majority

# ── JWT Secret ────────────────────────────────────────────────────────────────
# PRODUCTION: Must be a 64+ character random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ── CORS Whitelist ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (e.g., your Vercel or custom domain).
ALLOWED_ORIGINS=https://lupu.in,https://www.lupu.in,https://lupu.vercel.app

# ── Firebase Admin SDK (Production Auth & Verification) ───────────────────────
# Option 1 (Recommended): Minified JSON string of your Firebase Service Account private key
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"uniride-9be37",...}
#
# Option 2 (Fallback): Project ID
FIREBASE_PROJECT_ID=uniride-9be37
FIREBASE_DATABASE_URL=https://uniride-9be37-default-rtdb.firebaseio.com

# ── Future Integration: Payment Gateway (Razorpay) ───────────────────────────
# RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
# RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET


