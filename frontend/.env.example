# ── LUPU Frontend Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Backend API URL ───────────────────────────────────────────────────────────
# In development with Vite proxy, use /api (relative).
# In production on Vercel, set to your deployed backend URL (e.g. https://api.lupu.in/api or https://lupu-backend.onrender.com/api)
VITE_API_URL=https://api.lupu.in/api

